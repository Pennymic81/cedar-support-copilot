# Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres with pgvector (docker compose up -d starts one on this address)
DATABASE_URL=postgres://cedar:cedar@localhost:5432/cedar

# Copilot
EMBEDDING_DIMENSIONS=1536
# local = offline, no key needed. openai = any OpenAI-compatible embeddings API.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
MAX_UPLOAD_MB=10

# Answers: local = no key, replies with the matching policy text.
# openai = any OpenAI-compatible chat API. Examples for LLM_API_BASE:
#   OpenAI     https://api.openai.com/v1
#   Groq       https://api.groq.com/openai/v1
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER=local
LLM_CHAT_MODEL=gpt-4o-mini
RETRIEVAL_TOP_K=4
# Leave blank to use the provider default (0.21 local, tuned with run_evals --sweep; 0.45 otherwise)
DEFAULT_CONFIDENCE_THRESHOLD=
